diff --git a/nes_py/nes/src/lib_nes_env.cpp b/nes_py/nes/src/lib_nes_env.cpp
index e8f9bf0..5298acf 100644
--- a/nes_py/nes/src/lib_nes_env.cpp
+++ b/nes_py/nes/src/lib_nes_env.cpp
@@ -114,6 +114,78 @@ extern "C" {
     EXP int CheatCount(NES::Emulator* emu) {
         return emu->cheat_count();
     }
+
+    // ------------------------------------------------------------------
+    // Instruction-level tracing
+    //
+    // Tracing is inactive until a filter is set, and costs one predictable
+    // branch per instruction when inactive. TraceWatch records instructions
+    // starting at a given CPU address; TraceRecordNonROM records any
+    // instruction executed outside PRG ROM, i.e. a derailed program counter.
+    // ------------------------------------------------------------------
+
+    /// Watch (on != 0) or unwatch a CPU address.
+    EXP void TraceWatch(NES::Emulator* emu, unsigned int address, int on) {
+        emu->get_tracer().set_watch(
+            static_cast<NES::NES_Address>(address & 0xFFFF), on != 0);
+    }
+
+    /// Stop watching every address.
+    EXP void TraceClearWatches(NES::Emulator* emu) {
+        emu->get_tracer().clear_watches();
+    }
+
+    /// Record every instruction whose program counter is below $8000.
+    EXP void TraceRecordNonROM(NES::Emulator* emu, int on) {
+        emu->get_tracer().set_record_non_rom(on != 0);
+    }
+
+    /// Set the maximum number of retained events.
+    EXP void TraceSetCapacity(NES::Emulator* emu, unsigned int n) {
+        emu->get_tracer().set_capacity(static_cast<size_t>(n));
+    }
+
+    /// Discard all recorded events.
+    EXP void TraceClear(NES::Emulator* emu) {
+        emu->get_tracer().clear();
+    }
+
+    /// Return the number of recorded events.
+    EXP unsigned int TraceCount(NES::Emulator* emu) {
+        return static_cast<unsigned int>(emu->get_tracer().size());
+    }
+
+    /// Return the number of events dropped because the buffer was full.
+    EXP unsigned long long TraceDropped(NES::Emulator* emu) {
+        return emu->get_tracer().num_dropped();
+    }
+
+    /// Return whether any trace filter is active.
+    EXP int TraceActive(NES::Emulator* emu) {
+        return emu->get_tracer().is_active() ? 1 : 0;
+    }
+
+    /// Copy up to `max_events` events into `out` as packed 16-byte records:
+    ///   u16 pc, u8 opcode, u8 a, u8 x, u8 y, u8 sp, u8 status, u8 flags,
+    ///   u64 instruction_index
+    /// Returns the number of events written.
+    EXP unsigned int TraceGet(NES::Emulator* emu, unsigned char* out,
+                              unsigned int max_events) {
+        NES::Tracer& t = emu->get_tracer();
+        unsigned int n = static_cast<unsigned int>(t.size());
+        if (n > max_events) n = max_events;
+        for (unsigned int i = 0; i < n; i++) {
+            const NES::TraceEvent& e = t.at(i);
+            unsigned char* p = out + i * 16;
+            p[0] = e.pc & 0xFF; p[1] = (e.pc >> 8) & 0xFF;
+            p[2] = e.opcode; p[3] = e.a; p[4] = e.x; p[5] = e.y;
+            p[6] = e.sp; p[7] = e.status; p[8] = e.flags;
+            p[9] = p[10] = p[11] = 0;
+            uint64_t c = e.cycle;
+            for (int k = 0; k < 4; k++) p[12 + k] = (c >> (8 * k)) & 0xFF;
+        }
+        return n;
+    }
 }
 
