     cycles = 0;
     register_A = 0;
@@ -550,7 +551,16 @@ void CPU::cycle(MainBus &bus) {
     // reset the number of skip cycles to 0
     skip_cycles = 0;
     // read the opcode from the bus and lookup the number of cycles
+    const NES_Address trace_pc = register_PC;
     NES_Byte op = bus.read(register_PC++);
+    ++instruction_count;
+    // Optional instruction-level trace. When no tracer is attached, or the
+    // tracer has no active filter, this costs one predictable branch.
+    if (tracer != nullptr && tracer->is_active())
+        tracer->on_instruction(
+            trace_pc, op,
+            register_A, register_X, register_Y, register_SP, flags.byte,
+            instruction_count);
     // Using short-circuit evaluation, call the other function only if the
     // first failed. ExecuteImplied must be called first and ExecuteBranch
     // must be before ExecuteType0
