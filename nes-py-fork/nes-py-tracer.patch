diff --git a/nes_py/nes/include/tracer.hpp b/nes_py/nes/include/tracer.hpp
new file mode 100644
index 0000000..98dad2d
--- /dev/null
+++ b/nes_py/nes/include/tracer.hpp
@@ -0,0 +1,129 @@
+//  Program:      nes-py
+//  File:         tracer.hpp
+//  Description:  Optional instruction-level CPU tracing.
+//
+//  Records one record per executed instruction, filtered so that the common
+//  case costs a single predictable branch. Two independent filters:
+//
+//    * a 64 KiB PC bitmap   - record when the instruction starts at a watched
+//                             address (e.g. $8E04 entry, $8E16 dispatch)
+//    * record_non_rom       - record whenever the program counter leaves PRG
+//                             ROM ($0000-$7FFF), which is the signal that
+//                             execution has derailed into RAM or I/O space
+//
+//  When tracing is disabled the hook is one boolean test, so an untraced run
+//  behaves exactly as before.
+//
+
+#ifndef TRACER_HPP
+#define TRACER_HPP
+
+#include <cstdint>
+#include <vector>
+#include "common.hpp"
+
+namespace NES {
+
+/// One executed instruction.
+struct TraceEvent {
+    uint16_t pc;        ///< address the instruction was fetched from
+    uint8_t  opcode;    ///< the opcode byte
+    uint8_t  a;         ///< accumulator before execution
+    uint8_t  x;         ///< X before execution
+    uint8_t  y;         ///< Y before execution
+    uint8_t  sp;        ///< stack pointer before execution
+    uint8_t  status;    ///< flags byte before execution
+    uint8_t  flags;     ///< bit 0: PC was outside PRG ROM
+    uint64_t cycle;     ///< CPU cycle count at the fetch
+};
+
+/// Bit set in TraceEvent::flags when the instruction executed outside PRG ROM.
+static const uint8_t TRACE_FLAG_NON_ROM = 0x01;
+
+/// Instruction-level trace buffer with PC filtering.
+class Tracer {
+ private:
+    /// whether any recording is active (the single hot-path test)
+    bool active = false;
+    /// record every instruction whose PC is below $8000
+    bool record_non_rom = false;
+    /// true when at least one PC is watched
+    bool any_watched = false;
+    /// one byte per CPU address; non-zero means "record instructions here"
+    std::vector<uint8_t> watched;
+    /// recorded events, capped at capacity
+    std::vector<TraceEvent> events;
+    /// maximum number of events to retain
+    size_t capacity = 65536;
+    /// number of events dropped because the buffer was full
+    uint64_t dropped = 0;
+
+    /// Recompute the hot-path flag.
+    inline void refresh() { active = record_non_rom || any_watched; }
+
+ public:
+    Tracer() : watched(0x10000, 0) { }
+
+    /// Return whether the tracer should be consulted at all.
+    inline bool is_active() const { return active; }
+
+    /// Enable or disable recording of execution outside PRG ROM.
+    inline void set_record_non_rom(bool on) { record_non_rom = on; refresh(); }
+
+    /// Start or stop watching a single CPU address.
+    inline void set_watch(NES_Address address, bool on) {
+        watched[address & 0xFFFF] = on ? 1 : 0;
+        if (on) {
+            any_watched = true;
+        } else {
+            any_watched = false;
+            for (size_t i = 0; i < watched.size(); i++)
+                if (watched[i]) { any_watched = true; break; }
+        }
+        refresh();
+    }
+
+    /// Stop watching every address.
+    inline void clear_watches() {
+        std::fill(watched.begin(), watched.end(), 0);
+        any_watched = false;
+        refresh();
+    }
+
+    /// Set the maximum number of retained events.
+    inline void set_capacity(size_t n) { capacity = n; }
+
+    /// Discard recorded events and the dropped counter.
+    inline void clear() { events.clear(); dropped = 0; }
+
+    /// The number of recorded events.
+    inline size_t size() const { return events.size(); }
+
+    /// The number of events discarded because the buffer was full.
+    inline uint64_t num_dropped() const { return dropped; }
+
+    /// Access a recorded event.
+    inline const TraceEvent& at(size_t i) const { return events[i]; }
+
+    /// Record an instruction if it passes the filters. Called from CPU::cycle
+    /// only when is_active() is true.
+    inline void on_instruction(
+        NES_Address pc, NES_Byte opcode,
+        NES_Byte a, NES_Byte x, NES_Byte y, NES_Byte sp, NES_Byte status,
+        uint64_t cycle
+    ) {
+        const bool non_rom = pc < 0x8000;
+        if (!((record_non_rom && non_rom) || watched[pc])) return;
+        if (events.size() >= capacity) { dropped++; return; }
+        TraceEvent e;
+        e.pc = pc; e.opcode = opcode;
+        e.a = a; e.x = x; e.y = y; e.sp = sp; e.status = status;
+        e.flags = non_rom ? TRACE_FLAG_NON_ROM : 0;
+        e.cycle = cycle;
+        events.push_back(e);
+    }
+};
+
+}  // namespace NES
+
+#endif  // TRACER_HPP
